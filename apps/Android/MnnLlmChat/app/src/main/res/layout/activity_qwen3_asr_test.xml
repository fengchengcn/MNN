<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:fillViewport="true"
    android:scrollbarSize="4dp"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Header ── -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qwen3-ASR Test"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Recognition Testing Tool"
            android:textColor="#888899"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- ═══════════ Engine Section ═══════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENGINE"
            android:textColor="#5E5E72"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:id="@+id/engineSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="22dp"
            android:visibility="gone" />

        <!-- ═══════════ Mode Section ═══════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODE"
            android:textColor="#5E5E72"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:id="@+id/modeSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/chipBatch"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="Batch"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_mode_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/chipStreaming"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="Streaming"
                android:gravity="center"
                android:textColor="#888899"
                android:textSize="14sp"
                android:background="@drawable/bg_mode_chip_normal"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/chipOmni"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="OMNI-VAD"
                android:gravity="center"
                android:textColor="#888899"
                android:textSize="14sp"
                android:background="@drawable/bg_mode_chip_normal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Record Button ── -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnRecord"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:text="REC"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_rec_button_idle"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <!-- ── Status ── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#888899"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <!-- ── Audio Level Bar ── -->
        <LinearLayout
            android:id="@+id/audioLevelContainer"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:orientation="horizontal"
            android:background="#2A2A3E"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <View
                android:id="@+id/audioLevelFill"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_audio_level_bar" />
        </LinearLayout>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E30"
            android:layout_marginBottom="18dp" />

        <!-- ── Results Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RESULTS"
                android:textColor="#5E5E72"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Clear"
                android:textColor="#2E65C2"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_mode_chip_normal"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Results Container ── -->
        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No results yet.\nTap REC to start recording."
                android:textColor="#555566"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="32dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
