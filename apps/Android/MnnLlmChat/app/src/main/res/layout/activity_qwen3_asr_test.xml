<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:fillViewport="true"
    android:scrollbarSize="4dp"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Header ── -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qwen3-ASR Test"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Recognition Testing Tool"
            android:textColor="#888899"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- ── Omni Mode Toggle ── -->
        <TextView
            android:id="@+id/chipOmni"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="OMNI-VAD"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_mode_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="28dp"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <!-- ── Model Parameters (collapsible) ── -->
        <LinearLayout
            android:id="@+id/paramsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模型参数"
                android:textColor="#5E5E72"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/paramsArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="#5E5E72"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/paramsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_asr_result_card"
            android:padding="14dp"
            android:layout_marginBottom="28dp"
            android:visibility="gone" />

        <!-- ── Record Button ── -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnRecord"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:text="录音"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_rec_button_idle"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <!-- ── Status ── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="就绪"
            android:textColor="#888899"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <!-- ── Audio Level Bar ── -->
        <LinearLayout
            android:id="@+id/audioLevelContainer"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:orientation="horizontal"
            android:background="#2A2A3E"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <View
                android:id="@+id/audioLevelFill"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_audio_level_bar" />
        </LinearLayout>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E30"
            android:layout_marginBottom="18dp" />

        <!-- ── Results Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="识别结果"
                android:textColor="#5E5E72"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="清除"
                android:textColor="#2E65C2"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_mode_chip_normal"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Results Container ── -->
        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无识别结果。\n点击录音按钮开始。"
                android:textColor="#555566"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="32dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
